cabal-version: 3.0

name:         json2dir-hs
version:      0.1
author:       Dmitry Kovalev
maintainer:   Dmitry Kovalev
category:     json2dir
synopsis:     json2dir
description:  json2dir
homepage:     https://github.com/KovalevDima/json2dir-hs
bug-reports:  https://github.com/KovalevDima/json2dir-hs
license:      BSD-3-Clause
license-file: LICENSE
copyright:    2026 Dmitry Kovalev
build-type:   Simple

extra-doc-files:
  README.md

source-repository head
  type: git
  location: https://github.com/KovalevDima/json2dir-hs

executable json2dir-hs
  main-is: json2dir-hs.hs
  hs-source-dirs: .
  build-depends:
    -- GHC included libraries
    base >= 4.7 && <5,
    bytestring,
    binary,
    directory,
    filepath,
    -- External dependencies
    aeson,
    network < 4,
    text,
  default-language: Haskell2010
  default-extensions:
    BlockArguments
    TypeApplications
    ImportQualifiedPost
